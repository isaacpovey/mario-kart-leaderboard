DATABASE_URL=postgresql://postgres:password@localhost:5432/mario_kart
# Optional. Session-mode / direct Postgres URL used only by the LISTEN listener.
# Set this when DATABASE_URL goes through a transaction-mode pooler (e.g. Supavisor :6543)
# that accepts LISTEN but never delivers notifications.
# LISTEN_DATABASE_URL=postgresql://postgres:password@localhost:5432/mario_kart
JWT_SECRET=change-me-in-production-at-least-32-characters-long
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENABLE_PLAYGROUND=true
